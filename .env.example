# Copy to .env and fill in.  .env is git-ignored — never commit real values.

# --- Local PostgreSQL (the pipeline's own database, system of record) ---
DATABASE_URL=postgresql://mcpipe:mcpipe@localhost:5432/mcpipe

# --- Merchant feed URLs (contain affiliate tokens — secret) ---
# Ask the affiliate networks (Effinity / Netaffiliation / Webgains) for these,
# or copy from the v1 WordPress config.
FEED_SPEEDWAY_URL=
FEED_LABECANERIE_URL=
FEED_MAXXESS_URL=
FEED_MOTOAXXE_URL=
FEED_MOTOBLOUZ_URL=
# FC-Moto: Webgains feed URL + a bearer token (Webgains → account → API tokens)
FEED_FCMOTO_URL=
FEED_FCMOTO_TOKEN=

# --- WordPress MySQL (only used by the publish step, only in shadow/live mode) ---
# Leave empty until phase 2. Use a dedicated MySQL user, NOT the WordPress admin user.
WP_MYSQL_HOST=
WP_MYSQL_PORT=3306
WP_MYSQL_USER=
WP_MYSQL_PASSWORD=
WP_MYSQL_DB=
# off | shadow | live   -- controls whether publish writes real tables
PUBLISH_MODE=off

# --- Where downloaded feeds are stored ---
FEEDS_DIR=./feeds

# --- Mentions légales -------------------------------------------------------
# Laissées vides, les deux premières lignes ne s'affichent pas sur /infos :
# une mention légale à moitié remplie vaut moins qu'une ligne absente.
MENTIONS_EDITEUR=
MENTIONS_DIRECTEUR=
# Valeur par défaut dans le code si absent : contact@motocomparo.com
MENTIONS_CONTACT=

# --- Sources externes -------------------------------------------------------
# L'adresse racine du revendeur dont on relève les fiches techniques
# (`mcpipe revendeur`). Volontairement absente du dépôt : le code de collecte
# est public, la cible n'a pas à l'être. Sans elle, la commande s'arrête et le
# dit. Format attendu : https://www.exemple.com (sans barre oblique finale).
SOURCE_REVENDEUR_RACINE=

# --- Notification des messages de contact ------------------------------------
# Laissées vides, aucune tentative d'envoi n'a lieu : les messages restent
# visibles uniquement dans /admin, comportement par défaut du site. Remplies,
# un e-mail est envoyé à chaque message (en plus de l'écriture en base, jamais
# à sa place — un échec d'envoi ne fait perdre aucun message).
#
# Pensé pour une boîte Hostinger Mail (SSL implicite, port 465) : le compte
# qui envoie peut aussi recevoir, pas besoin d'une seconde adresse. Pour un
# autre hébergeur de messagerie, changer SMTP_HOST et SMTP_PORT.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@motocomparo.com
# Le mot de passe de CETTE boîte mail — jamais celui d'un compte personnel.
SMTP_PASS=
# Vide = envoyé à SMTP_USER lui-même.
CONTACT_NOTIF_TO=

# --- Mesure d'audience ------------------------------------------------------
# DEUX INTERRUPTEURS INDÉPENDANTS, tous deux facultatifs. Laissés vides, aucun
# script Google n'est écrit dans les pages, le bandeau de consentement ne
# s'affiche pas, et la page /infos affirme l'absence de mesure — ce qui est
# alors vrai.
#
# Le consentement est demandé AVANT toute mesure (Consent Mode v2, tout refusé
# par défaut). Refuser est aussi facile qu'accepter, le choix vaut six mois et
# se change par « Gérer les cookies » en bas de page.
#
# Google Tag Manager — le conteneur. Format : GTM-XXXXXXX
GTM_ID=
# Google Analytics 4 branché directement, sans conteneur. Format : G-XXXXXXXXXX
GA4_ID=
#
# ⚠️ NE PAS DÉCLARER GA4 DES DEUX CÔTÉS. Si GA4_ID est renseigné ici ET qu'une
# balise GA4 existe dans le conteneur GTM, chaque page est comptée DEUX FOIS et
# les chiffres sont faux sans que rien ne le signale. Choisir un seul chemin :
#   - GA4_ID seul          : le plus simple, rien à configurer ailleurs ;
#   - GTM_ID seul          : la balise GA4 se déclare dans l'interface GTM ;
#   - les deux, mais alors SANS balise GA4 dans le conteneur.
