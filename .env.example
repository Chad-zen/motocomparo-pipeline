# Copy to .env and fill in.  .env is git-ignored — never commit real values.

# --- Local PostgreSQL (the pipeline's own database, system of record) ---
DATABASE_URL=postgresql://mcpipe:mcpipe@localhost:5432/mcpipe

# --- Merchant feed URLs (contain affiliate tokens — secret) ---
# Ask the affiliate networks (Effinity / Netaffiliation / Webgains) for these,
# or copy from the v1 WordPress config.
FEED_SPEEDWAY_URL=
FEED_LABECANERIE_URL=
FEED_MAXXESS_URL=
FEED_MOTOAXXE_URL=
FEED_MOTOBLOUZ_URL=
# FC-Moto: Webgains feed URL + a bearer token (Webgains → account → API tokens)
FEED_FCMOTO_URL=
FEED_FCMOTO_TOKEN=

# --- WordPress MySQL (only used by the publish step, only in shadow/live mode) ---
# Leave empty until phase 2. Use a dedicated MySQL user, NOT the WordPress admin user.
WP_MYSQL_HOST=
WP_MYSQL_PORT=3306
WP_MYSQL_USER=
WP_MYSQL_PASSWORD=
WP_MYSQL_DB=
# off | shadow | live   -- controls whether publish writes real tables
PUBLISH_MODE=off

# --- Where downloaded feeds are stored ---
FEEDS_DIR=./feeds
