# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets
.env
.env.local
*.key
*.pem

# Downloaded feeds (large, and contain affiliate tokens in URLs — never commit)
feeds/
*.csv
*.csv.gz
!feeds_samples/*.csv

# Local data / dumps
*.sqlite
*.dump
*.sql.gz
data/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# local scratch / one-off analysis
.scratch/

# Journaux et relevés de mesure : utiles sur la machine, pas dans le dépôt.
ops/*.log
ops/*.json

# Les journaux du serveur de développement (`run_site.py`). Ils grossissent à
# chaque lancement, changent à chaque requête, et ne disent rien à personne
# d'autre qu'à la machine qui les a écrits.
site.log
site.err

# La sauvegarde de la base, fabriquée pour le transfert vers le VPS.
mcpipe.dump
dump.log

# Lanceur local du serveur de dev (chemins Windows, propre à la machine)
.claude/launch.json
