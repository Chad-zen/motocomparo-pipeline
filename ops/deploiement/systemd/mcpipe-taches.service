[Unit]
Description=MotoComparo — calculs demandés depuis l'administration
After=network-online.target postgresql@18-main.service

[Service]
Type=oneshot
User=motocomparo
Group=motocomparo
EnvironmentFile=/srv/motocomparo/.env
Environment=PATH=/srv/motocomparo/venv/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/motocomparo/app
# Le minuteur passe chaque minute : charger Python et ses bibliothèques coûte
# 12 secondes de processeur (mesuré le 16/10/2026), soit un cinquième d'un cœur
# en permanence pour ne rien faire. Cette condition, une requête `psql` de
# quelques millisecondes, ne laisse démarrer le vrai travail que s'il y a une
# demande en attente.
ExecCondition=/usr/local/bin/mcpipe-taches-attente
ExecStart=/srv/motocomparo/venv/bin/mcpipe taches
Nice=10
TimeoutStartSec=1h
# Le site garde ses listes trois heures : après un calcul qui change des
# données, l'exécuteur pose un drapeau, et c'est cette ligne — qui tourne en
# root grâce au « + » — qui redémarre le site (le compte applicatif n'en a pas
# le droit).
ExecStartPost=+/bin/sh -c 'if [ -e /srv/motocomparo/.redemarrer-site ]; then rm -f /srv/motocomparo/.redemarrer-site; find /var/cache/nginx/motocomparo -type f -delete; systemctl restart mcsite.service; fi'
